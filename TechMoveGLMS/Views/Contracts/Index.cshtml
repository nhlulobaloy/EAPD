@model IEnumerable<TechMoveGLMS.Models.Contract>

@{
    ViewData["Title"] = "Contracts";
}

<h2>Contracts</h2>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-3">
            <label>Start Date From:</label>
            <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-3">
            <label>End Date To:</label>
            <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
        </div>
        <div class="col-md-3">
            <label>Status:</label>
            <select name="status" class="form-control">
                <option value="">All</option>
                <option value="Draft">Draft</option>
                <option value="Active">Active</option>
                <option value="Expired">Expired</option>
                <option value="On Hold">On Hold</option>
            </select>
        </div>
        <div class="col-md-3">
            <label>&nbsp;</label>
            <button type="submit" class="btn btn-primary form-control">Filter</button>
        </div>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Create New Contract</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Client</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th>Service Level</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Client?.Name</td>
                <td>@item.StartDate.ToShortDateString()</td>
                <td>@item.EndDate.ToShortDateString()</td>
                <td>@item.Status</td>
                <td>@item.ServiceLevel</td>
                <td>
                    @if (!string.IsNullOrEmpty(item.SignedAgreementPath))
                    {
                        <a asp-action="DownloadPdf" asp-route-id="@item.Id" class="btn btn-sm btn-info">Download PDF</a>
                    }
                    <a asp-controller="ServiceRequests" asp-action="Create" asp-route-contractId="@item.Id" class="btn btn-sm btn-warning">Create Service Request</a>
                </td>
            </tr>
        }
    </tbody>
</table>