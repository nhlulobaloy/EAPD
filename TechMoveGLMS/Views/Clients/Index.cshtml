@model IEnumerable<TechMoveGLMS.Models.Client>

@{
    ViewData["Title"] = "Clients";
}

<h2>Clients</h2>

<p>
    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createModal">
        Create New Client
    </button>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Region</th>
            <th>Contracts Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.ContactEmail</td>
                <td>@item.ContactPhone</td>
                <td>@item.Region</td>
                <td>@item.Contracts?.Count</td>
            </tr>
        }
    </tbody>
</table>

<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Create Client</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Name</label>
                        <input name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Email</label>
                        <input name="ContactEmail" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Phone</label>
                        <input name="ContactPhone" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Region</label>
                        <input name="Region" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>